NODE_ENV=development
PORT=5100
PUBLIC_URL=http://localhost:5100
MONGODB_URI=mongodb://127.0.0.1:27017/driver_go

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=60

CORS_ORIGINS=http://localhost:5175,http://localhost:5176
# Number of reverse proxies in front of the API (1 behind nginx)
TRUST_PROXY=0

# Password given to the demo admins by `npm run seed`
SEED_ADMIN_PASSWORD=

# OTP is echoed in the API response outside production; set false to disable
OTP_DEV_MODE=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# mock (development only) or razorpay
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Swagger UI is always on outside production
ENABLE_API_DOCS=false
